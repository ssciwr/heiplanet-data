{
    "data_format": "netcdf",
    "data_folder": ".data_heiplanet_db/bronze/",
    "data_folder_out": ".data_heiplanet_db/silver/",
    "datasets": {
        "era5": {
            "enabled": false,
            "source": "era5",
            "base_name": "era5_data",
            "preprocess_settings": "default",
            "unique_tag": "silver",
            "dataset": "reanalysis-era5-land-monthly-means",
            "request": {
                "product_type": ["monthly_averaged_reanalysis"],
                "variable": ["2m_temperature"],
                "year": ["2024"],
                "month": ["01", "02", "03", "04", "05", "06", "07", "08", "09", "10", "11", "12"],
                "time": ["00:00"],
                "data_format": "netcdf",
                "download_format": "unarchived"
            }
        },
        "era5_daily": {
            "enabled": true,
            "source": "era5",
            "base_name": "era5_data_daily",
            "preprocess_settings": "default",
            "unique_tag": "silver",
            "dataset": "reanalysis-era5-land",
            "variable": ["2m_temperature", "total_precipitation"],
            "start_date": "2024-01-01",
            "end_date": "2024-12-31"
        },
        "isimip": {
            "enabled": true,
            "source": "isimip",
            "base_name": "isimip_population_data",
            "preprocess_settings": "default",
            "unique_tag": "silver",
            "search_path": "ISIMIP3a/InputData/socioeconomic/pop/histsoc/population",
            "file_match": "population_histsoc_30arcmin_annual_1901_2021"
        }
    },
    "nuts_aggregation": {
        "enabled": false,
        "data_folder": "../../heiplanet-models/.data_heiplanet_db/gold/",
        "data_folder_out": ".data_heiplanet_db/gold/",
        "nuts_file": "NUTS_RG_20M_2024_4326.shp.zip",
        "nuts_url": "https://heibox.uni-heidelberg.de/f/e95125307161470a8906/?dl=1",
        "nuts_hash": "246a5e1a3901380f194879cff5a65bbac86c9c906a7871027a3a918dbe6c7e46",
        "normalize_time": true,
        "datasets": {
            "jmodel": {
                "file": "era5_data_2014-2018_allm_2t_monthly_unicoords_adjlon_celsius_silver_output_JModel_global.nc",
                "agg": {"R0": "mean"}
            },
            "pmodel": {
                "file": "Mosquito_abundance_Global_2014-2018.nc",
                "agg": {"adults": "mean"}
            }
        }
    }
}
